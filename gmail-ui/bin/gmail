#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$SCRIPT_DIR:$SCRIPT_DIR/environment${PYTHONPATH:+:$PYTHONPATH}"

if [[ -S "/run/gmail/agent.sock" ]]; then
  exec python3 -m gmail_sim.agent_cli "$@"
else
  exec python3 -m tools.gmail_cli "$@"
fi
